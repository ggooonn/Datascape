        1000,
        2500,
        5000
      ],
      "candidate_contact_release_feeds_mm_min": [
        100,
        300,
        1000,
        1500,
        2000
      ],
      "permission": "One variable at a time; faster contact/release/pressure Z only after quality/recovery and controller acceleration tests"
